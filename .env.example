# LEGO War Universe - 后台免费大模型环境变量配置示例
# 在 Cloudflare Pages 仪表盘中配置为环境变量，或本地开发时配置到 .env 中

# 1. Groq (免费极速推理，首选推荐): https://console.groq.com/keys
GROQ_API_KEY=

# 2. OpenRouter (汇聚大量免费开源模型，如 deepseek-r1:free, llama-3.3:free): https://openrouter.ai/keys
OPENROUTER_API_KEY=

# 3. Google Gemini (官方免费层 API): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 4. 允许跨域访问后台接口的前端源（必须精确匹配，留空则仅允许同源）
#    例如：ALLOWED_ORIGIN=https://legowaruniverse.pages.dev
ALLOWED_ORIGIN=

# 运行环境标记
ENVIRONMENT=development
AUTH_MODE=disabled
