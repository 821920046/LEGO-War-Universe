# Local agent / tooling state (never commit)
.workbuddy-ai/
.agents/

# Environment files (use .env.example as the template)
.env
.env.local
.env.*.local
# Cloudflare 的本地环境变量约定文件（wrangler pages dev / wrangler dev 会读它）。
# 6.8.3 之前**没有**忽略它 —— 按标准流程建 .dev.vars 填真 Key 会被 git 提交上去，
# 等于把 API Key 直接推到远端。凡是可能装密钥的文件都必须在这里列全。
.dev.vars
.dev.vars.*
.wrangler/

# Node / Python artifacts
node_modules/
__pycache__/
*.pyc
.DS_Store
Thumbs.db
# scripts/build-assets.mjs 原子写的中间文件（rename 前若进程被强杀会残留）。
# 6.8.8：不清掉的话 `git add -A` 会把它们当新文件提交。
*.tmp-*

# OpenRouter 基准测试的原始输出（scripts/bench-openrouter.mjs）
_bench_result.json
